PORT=3000

# Supabase (service role key — server-only, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# QuPilot Anchor program id (base58)
QUPILOT_PROGRAM_ID=

# QuPilot admin signer (secret). Provide base58/base64 encoded secretKey (64 bytes) OR set QUPILOT_ADMIN_KEYPAIR_PATH to a solana-keygen JSON array.
QUPILOT_ADMIN_KEYPAIR_BASE64=
# or
QUPILOT_ADMIN_KEYPAIR_PATH=
