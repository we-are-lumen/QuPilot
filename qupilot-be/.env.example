PORT=3000

# Supabase (service role key — server-only, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# QuPilot Anchor program id (base58)
QUPILOT_PROGRAM_ID=

# Treasury signer (base58 secret key) used to send SOL reward transfers on claim
SOLANA_TREASURY_SECRET_KEY=
