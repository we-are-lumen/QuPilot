PORT=3000

# Supabase (service role key — server-only, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# EVM RPC (legacy — kept for treasury ERC20 reward payouts)
EVM_RPC_URL=https://rpc.sepolia.mantle.xyz
CHAIN_ID=5003

# Solana RPC for on-chain verification of quest executions (Byreal swaps)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury signer (private key hex 64 chars, optional 0x) used to send reward transfers on claim
TREASURY_PRIVATE_KEY=
